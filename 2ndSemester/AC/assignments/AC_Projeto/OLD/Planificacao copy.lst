  86           	; ------------------------------------------------------------
  87           	; Roll a dice action
  88           	; -------------------------------------------------------------
  89           	; Input:
  90           	; r0 - Previous die index (0 for d4, 1 for d6, 2 for d8, 3 for d12)
  91           	; Returns:
  92           	; r0 - New die index (0 for d4, 1 for d6, 2 for d8, 3 for d12)
  93           	action:
  94 004C 0E 24	    push lr ; Save the link register
  95 004E 04 24	    push r4 ; Save r4 on the stack
  96 0050 04 B0	    mov r4, r0 ; Store the previous die index in r4
  97           	
  98 0052 39 5C	    bl inport_read ; Read the input port
  99 0054 C5 60	    mov r5, #DICE_MASK ; Load the die sides mask
 100 0056 80 C2	    and r0, r0, r5 ; Mask the input to get the roll switch state
 101 0058 00 E9	    lsr r0, r0, #2
 102 005A 00 BA	    cmp r0, r4
 103 005C 04 40	    beq action_end ; If the roll switch state is the same, return
 104 005E 04 B0	    mov r4, r0
 105 0060 04 5C	    bl roll ; Call the roll function to generate a new die index
 106 0062 35 5C	    bl outport_write ; Output the new die index to the display
 107 0064 00 B2	    mov r0, r4 ; Update r4 with the new die index
 108           	
 109           	action_end:
 110 0066 04 04	    pop r4 ; Restore r4
 111 0068 0F 04	    pop pc ; Return from action
