 130           	; Returns:
 131           	; r0 - Maximum sides for the die
 132           	getDiceMax:
 133 0072 04 24	    push r4 ; Save r4 on the stack
 134 0074 44 60	    mov r4, #TOTAL_SIDES ; Load the total number of sides for the die
 135 0076 00 BA	    cmp r0, r4 ; Compare the input with the total sides
 136 0078 03 50	    bge getDiceMax_end ; If input is greater or equal, return
 137 007A 80 E0	    lsl r0, r0, #1 ; Double the input value (to match the die sides)
 138 007C 04 6E	    mov r4, #max_sides
 139 007E 40 10	    ldr r0, [r4, r0] ; Load the maximum sides for the die
