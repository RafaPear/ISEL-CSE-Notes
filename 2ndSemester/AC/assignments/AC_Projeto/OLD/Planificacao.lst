  62           	; ------------------------------------------------------------
  63           	; Roll a dice action
  64           	; -------------------------------------------------------------
  65           	; Input:
  66           	; r0 - Previous die index (0 for d4, 1 for d6, 2 for d8, 3 for d12)
  67           	; Returns:
  68           	; r0 - New die index (0 for d4, 1 for d6, 2 for d8, 3 for d12)
  69           	action:
  70 0032 0E 24	    push lr ; Save the link register
  71 0034 04 24	    push r4 ; Save r4 on the stack
  72 0036 04 B0	    mov r4, r0 ; Store the previous die index in r4
  73           	
  74 0038 39 5C	    bl inport_read ; Read the input port
  75 003A C5 60	    mov r5, #DICE_MASK ; Load the die sides mask
  76 003C 80 C2	    and r0, r0, r5 ; Mask the input to get the roll switch state
  77 003E 00 E9	    lsr r0, r0, #2
  78 0040 00 BA	    cmp r0, r4
