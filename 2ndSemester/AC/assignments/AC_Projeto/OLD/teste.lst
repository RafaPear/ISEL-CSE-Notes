 161           	; ------------ getDiceMax ---------------------------------------------
 162           	; ------------------------------------------------------------
 163           	; Get the maximum sides for the die based on the index
 164           	; Input:
 165           	; r0 - Die index (0 for d4, 1 for d6, 2 for d8, 3 for d12)
 166           	; Returns:
 167           	; r0 - Maximum sides for the die
 168           	getDiceMax:
 169 0088 04 24	    push r4 ; Save r4 on the stack
 170 008A 44 60	    mov r4, #TOTAL_SIDES ; Load the total number of sides for the die
 171 008C 00 BA	    cmp r0, r4 ; Compare the input with the total sides
 172 008E 03 50	    bge getDiceMax_end ; If input is greater or equal, return
 173 0090 80 E0	    lsl r0, r0, #1 ; Double the input value (to match the die sides)
 174 0092 A4 6E	    mov r4, #max_sides
 175 0094 40 10	    ldr r0, [r4, r0] ; Load the maximum sides for the die
 176           	getDiceMax_end:
 177 0096 04 04	    pop r4 ; Restore r4
 178 0098 0F B7	    mov pc, lr ; Return from getDiceMax
