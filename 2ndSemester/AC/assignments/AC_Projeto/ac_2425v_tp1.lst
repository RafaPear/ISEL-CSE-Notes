 211 00BC 40 B8		cmp	r4, r0
 212 00BE 0D 44		bne	main_ret
 213           		; Avaliar se o valor de i ainda e inferior a N
 214           		; Nota: Considera-se que N pode tomar qualquer valor no dominio de i
