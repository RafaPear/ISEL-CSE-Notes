 188           	;            R1 - guarda valores temporariamente
 189           	;            R2 - guarda valores temporariamente
 190           	;            R3 - guarda valores temporariamente
 191           	;            R4 - mapeia a variavel error
 192           	;            R5 - guarda o valor da iteracao do ciclo for (i)
 193           	;
 194           	main:
 195           		; Prologo
 196 00A8 0E 24		push	lr
 197 00AA 05 24		push	r5
 198 00AC 04 24		push	r4
 199           	
 200 00AE 04 60		mov	r4, #0	; Iniciar error
 201           		; Iniciar seed com o valor 5423
 202 00B0 F0 62		mov	r0, #( 5423 >> 0 ) & 0xFF	; Carregar o valor 5423 (tipo uint32_t)
 203 00B2 50 71		movt	r0, #( 5423 >> 8 ) & 0xFF
 204 00B4 01 60		mov	r1, #0
 205 00B6 D4 5F		bl	srand
