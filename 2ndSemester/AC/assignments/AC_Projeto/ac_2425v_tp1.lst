 172 009C 42 0C		ldr	r2, seed_addr_rand
 173 009E 20 20		str	r0, [r2, #0]
 174 00A0 A1 20		str	r1, [r2, #2]
 175           		; Epilogo
 176 00A2 80 B0		mov	r0, r1	; Preparar o valor a devolver (16 MSb do valor)
 177 00A4 0F 04		pop	pc
