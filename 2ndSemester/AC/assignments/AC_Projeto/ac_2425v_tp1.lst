 121           	; Rotina:    rand
 122           	; Descricao: Implementa um gerador congruencial linear (LCG) para gerar numeros
 123           	;            pseudo-aleatorios entre zero e RAND_MAX.
 124           	;            Interface exemplo: uint16_t rand( void );
 125           	; Entradas:  -
 126           	; Saidas:    R0 - O valor pseudo-aleatorio gerado
 127           	; Efeitos:   Altera o valor da variavel global seed
 128           	;            R0 - guarda valores temporariamente
 129           	;            R1 - guarda valores temporariamente
 130           	;            R2 - guarda valores temporariamente
 131           	;            R3 - guarda valores temporariamente
 132           	;
 133           	rand:
 134           		; Prologo
 135 006A 0E 24		push	lr
 136           		; Obter o valor atual de seed
 137 006C C2 0D		ldr	r2, seed_addr_rand
 138 006E 20 00		ldr	r0, [r2, #0]
 139 0070 A1 00		ldr	r1, [r2, #2]
 140           		; Calcular a multiplicacao a 32 bits
 141 0072 D2 6F		mov	r2, #( 0x43FD >> 0 ) & 0xFF	; Carregar o valor 214013
 142 0074 32 74		movt	r2, #( 0x43FD >> 8 ) & 0xFF
 143 0076 33 60		mov	r3, #( 0x0003 >> 0 ) & 0xFF
 144 0078 03 70		movt	r3, #( 0x0003 >> 8 ) & 0xFF
 145 007A C8 5F		bl	umull32
 146           		; Calcular a adicao a 32 bits
 147 007C 32 6C		mov	r2, #( 0x9EC3 >> 0 ) & 0xFF	; Carregar o valor 2531011
 148 007E E2 79		movt	r2, #( 0x9EC3 >> 8 ) & 0xFF
 149 0080 63 62		mov	r3, #( 0x0026 >> 0 ) & 0xFF
 150 0082 03 70		movt	r3, #( 0x0026 >> 8 ) & 0xFF
 151 0084 00 81		add	r0, r0, r2
 152 0086 91 91		adc	r1, r1, r3
 153           	
 154           	    ; Nao e necessario implementar a divisao modulo, pois a operacao realizada
 155           	    ; com valores de 32 bits nunca ultrapassa o valor RAND_MAX (0xFFFFFFFF).
 156           	    ; No entanto, a operacao % RAND_MAX deve devolver 0 quando o novo valor de
 157           	    ; seed e exatamente igual a RAND_MAX. Assim, e suficiente verificar este
 158           	    ; caso e forcar seed a zero.
 159 0088 F2 6F		mov	r2, #( RAND_MAX_L >> 0 ) & 0xFF
 160 008A F2 7F		movt	r2, #( RAND_MAX_L >> 8 ) & 0xFF
 161 008C 00 B9		cmp r0, r2
 162 008E 06 44		bne rand_save_seed
 163 0090 F3 6F		mov	r3, #( RAND_MAX_H >> 0 ) & 0xFF
 164 0092 F3 7F		movt	r3, #( RAND_MAX_H >> 8 ) & 0xFF
 165 0094 90 B9		cmp r1, r3
 166 0096 02 44		bne rand_save_seed
 167 0098 00 60		mov r0, #0  	; Atribuir a seed o valor 0
 168 009A 01 60		mov r1, #0
