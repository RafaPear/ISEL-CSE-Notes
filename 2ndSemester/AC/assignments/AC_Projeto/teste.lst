 310           	; Rotina:    umull32
 311           	; Descricao: Realiza a multiplicacao de dois numeros naturais codificados com
 312           	;            32 bits.
 313           	;            Interface exemplo: uint32_t umull( uint32_t M, uint32_t m );
 314           	; Entradas:  R1:R0 - Valor do multiplicando (M)
 315           	;            R3:R2 - Valor do multiplicador (m)
 316           	; Saidas:    R1:R0 - Valor do produto
 317           	; Efeitos:   R5:R4 - Parte alta (bits 63..32) do produto (p), pois R3:R2 contem
 318           	;                    a parte baixa (bits 31..0)
 319           	;            R6    - Mapeia a variavel p_1
 320           	;            R7    - guarda o valor da iteracao do ciclo for (i)
 321           	;            R8    - guarda valores temporariamente
 322           	;
 323           	umull32:
 324           	    ; Prologo
 325 012E 08 24	    push    r8
 326 0130 07 24	    push    r7
 327 0132 06 24	    push    r6
 328 0134 05 24	    push    r5
 329 0136 04 24	    push    r4
 330           	
 331           	    ; Iniciar p fazendo a extensao de sinal aos 16 MSb
 332 0138 B4 F7	    asr     r4, r3, #15
 333 013A 05 B2	    mov     r5, r4
 334           	    ; Inicia p_1
 335 013C 06 60	    mov     r6, #0
 336           	    ; Implementacao do ciclo for
 337 013E 07 60	    mov     r7, #0      ; Inicia i
 338           	umull32_loop:
 339 0140 08 62	    mov     r8, #32     ; Avaliar o limite maximo de i
 340 0142 70 BC	    cmp     r7, r8
 341 0144 16 48	    bhs     umull32_ret
 342           	    ; Implementacao do if
 343 0146 18 60	    mov     r8, #1
 344 0148 28 C4	    and     r8, r2, r8
 345 014A 06 44	    bzc     umull32_else
 346 014C 18 60	    mov     r8, #1
 347 014E 60 BC	    cmp     r6, r8
 348 0150 08 44	    bne     umull32_loop_end
 349 0152 44 80	    add     r4, r4, r0  ; Atualizar o valor de p
 350 0154 D5 90	    adc     r5, r5, r1
 351 0156 05 58	    b       umull32_loop_end
 352           	umull32_else:
 353           	    ; Implementacao otimizada do else
 354 0158 08 60	    mov     r8, #0
 355 015A 60 BC	    cmp     r6, r8
 356 015C 02 44	    bne     umull32_loop_end
 357 015E 44 88	    sub     r4, r4, r0  ; Atualizar o valor de p
 358 0160 D5 98	    sbc     r5, r5, r1
 359           	umull32_loop_end:
 360 0162 18 60	    mov     r8, #1      ; Definir o novo valor de p_1
 361 0164 26 C4	    and     r6, r2, r8
 362 0166 D5 F0	    asr     r5, r5, #1
 363 0168 44 D8	    rrx     r4, r4
 364 016A 33 D8	    rrx     r3, r3
 365 016C 22 D8	    rrx     r2, r2
 366 016E F7 A0	    add     r7, r7, #1  ; Incrementar i
 367 0170 E7 5B	    b       umull32_loop
 368           	
 369           	umull32_ret:
 370           	    ; Epilogo
 371 0172 00 B1	    mov     r0, r2      ; Preparar o valor a devolver
 372 0174 81 B1	    mov     r1, r3
 373           	
 374 0176 04 04	    pop     r4
 375 0178 05 04	    pop     r5
 376 017A 06 04	    pop     r6
 377 017C 07 04	    pop     r7
 378 017E 08 04	    pop     r8
 379 0180 0F B7	    mov     pc, lr
