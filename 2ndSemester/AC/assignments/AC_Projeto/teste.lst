 230           	; ------------ getDiceMax ---------------------------------------------
 231           	; ------------------------------------------------------------
 232           	; Get the maximum sides for the die based on the index
 233           	; Input:
 234           	; r0 - Die index (0 for d4, 1 for d6, 2 for d8, 3 for d12)
 235           	; Returns:
 236           	; r0 - Maximum sides for the die
 237           	getDiceMax:
 238 00DA 04 24	    push    r4                     ; Save r4 on the stack
 239 00DC 44 60	    mov     r4, #TOTAL_SIDES       ; Load the total number of sides for the die
 240 00DE 00 BA	    cmp     r0, r4                 ; Compare the input with the total sides
 241 00E0 03 50	    bge     getDiceMax_end         ; If input is greater or equal, return
 242 00E2 80 E0	    lsl     r0, r0, #1             ; Double the input value (to match the die sides)
 243 00E4 34 0C	    ldr     r4, ptr_max_sides      ; Load the address of max_sides
 244 00E6 40 10	    ldr     r0, [r4, r0]           ; Load the maximum sides for the die
 245           	getDiceMax_end:
 246 00E8 04 04	    pop     r4                     ; Restore r4
 247 00EA 0F B7	    mov     pc, lr                 ; Return from getDiceMax
 248           	
 249           	ptr_max_sides:
 250 00EC D8 01	    .word   max_sides
