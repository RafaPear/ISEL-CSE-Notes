 381           	; Rotina:    srand
 382           	; Descricao: Afeta a variavel global seed com um novo valor (semente),
 383           	;            recebido por parametro.
 384           	;            Interface exemplo: void srand( uint32_t nseed );
 385           	; Entradas:  R0 - Parte baixa (bits 0..15) do novo valor de seed
 386           	;            R1 - Parte alta (bits 16..31) do novo valor de seed
 387           	; Saidas:    -
 388           	; Efeitos:   Altera o valor da variavel global seed
 389           	;            R2 - guarda valores temporariamente
 390           	;
 391           	srand:
 392 0182 32 0C	    ldr     r2, seed_addr_srand
 393 0184 20 20	    str     r0, [r2, #0]
 394 0186 A1 20	    str     r1, [r2, #2]
 395 0188 0F B7	    mov     pc, lr
 396           	
 397           	seed_addr_srand:
 398 018A CA 01	    .word   seed
 399           	
 400           	; Rotina:    rand
 401           	; Descricao: Implementa um gerador congruencial linear (LCG) para gerar numeros
 402           	;            pseudo-aleatorios entre zero e RAND_MAX.
 403           	;            Interface exemplo: uint16_t rand( void );
 404           	; Entradas:  R0 - Valor maximo para gerar
 405           	; Saidas:    R0 - O valor pseudo-aleatorio gerado
 406           	; Efeitos:   Altera o valor da variavel global seed
 407           	;            R0 - guarda valores temporariamente
 408           	;            R1 - guarda valores temporariamente
 409           	;            R2 - guarda valores temporariamente
 410           	;            R3 - guarda valores temporariamente
 411           	;
 412           	rand:
 413           	    ; Prologo
 414 018C 0E 24	    push    lr
 415           	    ; Obter o valor atual de seed
 416 018E C2 0D	    ldr     r2, seed_addr_rand
 417 0190 20 00	    ldr     r0, [r2, #0]
 418 0192 A1 00	    ldr     r1, [r2, #2]
 419           	    ; Calcular a multiplicacao a 32 bits
 420 0194 D2 6F	    mov     r2, #( 0x43FD >> 0 ) & 0xFF    ; Carregar o valor 214013
 421 0196 32 74	    movt    r2, #( 0x43FD >> 8 ) & 0xFF
 422 0198 33 60	    mov     r3, #( 0x0003 >> 0 ) & 0xFF
 423 019A 03 70	    movt    r3, #( 0x0003 >> 8 ) & 0xFF
 424 019C C8 5F	    bl      umull32
 425           	    ; Calcular a adicao a 32 bits
 426 019E 32 6C	    mov     r2, #( 0x9EC3 >> 0 ) & 0xFF    ; Carregar o valor 2531011
 427 01A0 E2 79	    movt    r2, #( 0x9EC3 >> 8 ) & 0xFF
 428 01A2 63 62	    mov     r3, #( 0x0026 >> 0 ) & 0xFF
 429 01A4 03 70	    movt    r3, #( 0x0026 >> 8 ) & 0xFF
 430 01A6 00 81	    add     r0, r0, r2
 431 01A8 91 91	    adc     r1, r1, r3
 432           	
 433           	    ; Nao e necessario implementar a divisao modulo, pois a operacao realizada
 434           	    ; com valores de 32 bits nunca ultrapassa o valor RAND_MAX (0xFFFFFFFF).
 435           	    ; No entanto, a operacao % RAND_MAX deve devolver 0 quando o novo valor de
 436           	    ; seed e exatamente igual a RAND_MAX. Assim, e suficiente verificar este
 437           	    ; caso e forcar seed a zero.
 438 01AA F2 6F	    mov     r2, #( RAND_MAX_L >> 0 ) & 0xFF
 439 01AC F2 7F	    movt    r2, #( RAND_MAX_L >> 8 ) & 0xFF
 440 01AE 00 B9	    cmp     r0, r2
 441 01B0 06 44	    bne     rand_save_seed
 442 01B2 F3 6F	    mov     r3, #( RAND_MAX_H >> 0 ) & 0xFF
 443 01B4 F3 7F	    movt    r3, #( RAND_MAX_H >> 8 ) & 0xFF
 444 01B6 90 B9	    cmp     r1, r3
 445 01B8 02 44	    bne     rand_save_seed
 446 01BA 00 60	    mov     r0, #0      ; Atribuir a seed o valor 0
 447 01BC 01 60	    mov     r1, #0
 448           	
 449           	rand_save_seed:
 450           	    ; Atualizar o valor de seed
 451 01BE 42 0C	    ldr     r2, seed_addr_rand
 452 01C0 20 20	    str     r0, [r2, #0]
 453 01C2 A1 20	    str     r1, [r2, #2]
 454           	    ; Epilogo
 455 01C4 80 B0	    mov     r0, r1      ; Preparar o valor a devolver (16 MSb do valor)
 456 01C6 0F 04	    pop     pc
 457           	
 458           	seed_addr_rand:
 459 01C8 CA 01	    .word   seed
 460           	    ; Definicao da variavel global do tipo uint32_t com valor inicial 1
 461           	    ; Como o processador P16 utiliza ordenacao little endian, o byte menos
 462           	    ; significativo (LSB) é armazenado no endereço mais baixo, logo, o valor
 463           	    ; um (0x00000001) é escrito primeiro
 464           	seed:
 465          	    .word   1, 0
 465 01CA 01 00 00 00
