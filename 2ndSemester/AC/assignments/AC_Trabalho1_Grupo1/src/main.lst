 121           	    ; Função: mod
 122           	    ; Descrição: Calcula o módulo de um número de 64 bits
 123           	    ; Entradas: r0, r1 => M (dividendo)
 124           	    ;           r2, r3 => m (divisor)
 125           	    ; Saídas: r0, r1 => M % m (resultado do módulo)
 126           	    ; --------------------------------------------------------
 127           	
 128           	    mod:
 129 0074 04 24	        push r4 ; Salva r4 no stack
 130 0076 05 24	        push r5 ; Salva r5 no stack
 131 0078 04 89	        sub r4, r0, r2  ; r4 = M - m
 132 007A 95 99	        sbc r5, r1, r3  ; r5 = M - m (com borrow)
 133 007C 03 4C	        bcc mod_end ; Se carry, i.e. se o resultado for negativo, salta para o fim do módulo
 134           	    mod_loop:
 135 007E 00 89	        sub r0, r0, r2  ; r0 = M - m
 136 0080 91 99	        sbc r1, r1, r3  ; r1 = M - m (com borrow)
 137 0082 FD 4B	        bcs mod_loop    ; Se houver carry, continua o loop
 138           	    mod_end:
 139 0084 05 04	        pop r5  ; Restaura r5 do stack
 140 0086 04 04	        pop r4  ; Restaura r4 do stack
 141 0088 0F B7	        mov pc, lr  ; Retorna da função
